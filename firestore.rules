rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function approved() {
      return signedIn() && profile().status == 'approved';
    }

    function role() {
      return profile().role;
    }

    function isAdmin() {
      return approved() && (role() == 'admin' || role() == 'super_admin');
    }

    function isSuperAdmin() {
      return approved() && role() == 'super_admin';
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownsVolunteerField() {
      return approved() && request.resource.data.volunteerId == request.auth.uid;
    }

    function ownsExistingVolunteerField() {
      return approved() && resource.data.volunteerId == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if isSelf(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSelf(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status in ['pending', 'approved']
        && request.resource.data.role in ['volunteer', 'admin', 'super_admin'];
      allow update: if isSuperAdmin()
        || (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
        || (isSelf(userId)
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status);
      allow delete: if isSuperAdmin();
    }

    match /devotees/{devoteeId} {
      allow read: if approved();
      allow create: if isAdmin() || ownsVolunteerField();
      allow update: if isAdmin() || ownsExistingVolunteerField();
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || ownsExistingVolunteerField();
      allow create: if isAdmin() || ownsVolunteerField();
      allow update, delete: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read: if approved();
      allow create: if isAdmin() || ownsVolunteerField();
      allow update: if isAdmin() || ownsExistingVolunteerField();
      allow delete: if isAdmin();
    }

    match /culturalEvents/{eventId} {
      allow read: if approved();
      allow create: if approved();
      allow update, delete: if isAdmin() || (approved() && resource.data.addedBy == request.auth.uid);
    }

    match /vipGotrams/{gotramId} {
      allow read, write: if isAdmin();
    }

    match /pooja_slots/{slotId} {
      allow read, write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read, update: if isAdmin();
      allow create: if approved();
      allow delete: if isSuperAdmin();
    }

    match /settings/{settingId} {
      allow read: if approved();
      allow write: if isSuperAdmin();
    }

    match /counters/{counterId} {
      allow read, write: if approved();
    }

    match /activities/{activityId} {
      allow read: if approved();
      allow create: if approved();
      allow update, delete: if isAdmin();
    }

    match /spl_records/{recordId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
